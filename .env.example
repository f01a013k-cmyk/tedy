# Claude API キー（必須）
ANTHROPIC_API_KEY=sk-ant-...

# 案件データの保存先（既定: ./projects）
JIZOKUKA_WORKSPACE=./projects

# リライトの上限回数と目標スコア
JIZOKUKA_MAX_REVISIONS=3
JIZOKUKA_TARGET_SCORE=80

# 用途別モデル（既定値のままで問題ありません）
JIZOKUKA_MODEL_DRAFT=claude-opus-5
JIZOKUKA_MODEL_REVIEW=claude-opus-5
JIZOKUKA_MODEL_EXTRACT=claude-sonnet-5
